{
  "name": "somni-installer",
  "version": "1.2.1",
  "description": "somni desktop installer",
  "main": "main.js",
  "author": "somni",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist":  "electron-builder --win --linux"
  },
  "build": {
    "appId": "io.somni.installer",
    "productName": "somni-setup",
    "directories": {
      "output": "../dist/installer-app"
    },
    "files": [
      "main.js",
      "preload.js",
      "installer.html",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "../../icon-256.ico",
      "artifactName": "somni-setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "icon": "../../icon-256.png",
      "artifactName": "somni-setup-${version}.${ext}",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "../../icon-256.ico",
      "uninstallerIcon": "../../icon-256.ico",
      "installerHeader": null,
      "installerSidebar": null,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "somni"
    },
    "extraResources": [
      { "from": "../dist/somni-app/somni.exe", "to": "somni.exe", "if": "win" },
      { "from": "../dist/somni-app/somni.AppImage", "to": "somni.AppImage", "if": "linux" }
    ]
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^25.1.8"
  }
}
